<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/2026/fruit-disease#"
     xml:base="http://www.semanticweb.org/ontologies/2026/fruit-disease"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2026/fruit-disease">
        <rdfs:comment>Fruit Disease Detection and Care Recommendation Ontology for Agricultural Decision Support System</rdfs:comment>
        <rdfs:label>FruitDiseaseOntology</rdfs:label>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- #################################################################
         # Classes
         ################################################################# -->

    <owl:Class rdf:about="#Fruit"/>
    <owl:Class rdf:about="#Disease"/>
    <owl:Class rdf:about="#Symptom"/>
    <owl:Class rdf:about="#Image"/>
    <owl:Class rdf:about="#EnvironmentalFactor"/>
    <owl:Class rdf:about="#Diagnosis"/>
    <owl:Class rdf:about="#Treatment"/>
    <owl:Class rdf:about="#Prevention"/>
    <owl:Class rdf:about="#Severity"/>
    <owl:Class rdf:about="#Prediction"/>
    <owl:Class rdf:about="#User"/>
    <owl:Class rdf:about="#Pathogen"/>
    <owl:Class rdf:about="#Variety"/>

    <!-- #################################################################
         # Object Properties
         ################################################################# -->

    <owl:ObjectProperty rdf:about="#hasDisease">
        <rdfs:domain rdf:resource="#Fruit"/>
        <rdfs:range rdf:resource="#Disease"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasImage">
        <rdfs:domain rdf:resource="#Fruit"/>
        <rdfs:range rdf:resource="#Image"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasVariety">
        <rdfs:domain rdf:resource="#Fruit"/>
        <rdfs:range rdf:resource="#Variety"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#affectsFruit">
        <owl:inverseOf rdf:resource="#hasDisease"/>
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#Fruit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#causesSymptom">
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#Symptom"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#causedBy">
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#Pathogen"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSeverity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Disease"/>
                    <owl:Class rdf:about="#Prediction"/>
                    <owl:Class rdf:about="#Diagnosis"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="#Severity"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#treatedBy">
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#Treatment"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#preventedBy">
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#Prevention"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#favoredBy">
        <rdfs:domain rdf:resource="#Disease"/>
        <rdfs:range rdf:resource="#EnvironmentalFactor"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#represents">
        <rdfs:domain rdf:resource="#Image"/>
        <rdfs:range rdf:resource="#Fruit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#containsSymptom">
        <rdfs:domain rdf:resource="#Image"/>
        <rdfs:range rdf:resource="#Symptom"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#producesPrediction">
        <rdfs:domain rdf:resource="#Image"/>
        <rdfs:range rdf:resource="#Prediction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#predictsDisease">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="#Disease"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#basedOn">
        <rdfs:domain rdf:resource="#Diagnosis"/>
        <rdfs:range rdf:resource="#Image"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#basedOnPrediction">
        <rdfs:domain rdf:resource="#Diagnosis"/>
        <rdfs:range rdf:resource="#Prediction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#basedOnSymptom">
        <rdfs:domain rdf:resource="#Diagnosis"/>
        <rdfs:range rdf:resource="#Symptom"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#identifiesDisease">
        <rdfs:domain rdf:resource="#Diagnosis"/>
        <rdfs:range rdf:resource="#Disease"/>
    </owl:ObjectProperty>

    <!-- #################################################################
         # Data Properties
         ################################################################# -->

    <owl:DatatypeProperty rdf:about="#hasConfidence">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#scientificName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- #################################################################
         # Individuals
         ################################################################# -->

    <!-- Severities -->
    <owl:NamedIndividual rdf:about="#Severity_Healthy">
        <rdf:type rdf:resource="#Severity"/>
        <rdfs:label>Healthy</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Severity_Low">
        <rdf:type rdf:resource="#Severity"/>
        <rdfs:label>Low</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Severity_Moderate">
        <rdf:type rdf:resource="#Severity"/>
        <rdfs:label>Moderate</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Severity_High">
        <rdf:type rdf:resource="#Severity"/>
        <rdfs:label>High</rdfs:label>
    </owl:NamedIndividual>

    <!-- Environmental Factors -->
    <owl:NamedIndividual rdf:about="#Env_HighHumidity">
        <rdf:type rdf:resource="#EnvironmentalFactor"/>
        <rdfs:label>High Humidity (>80%)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Env_WarmTemperature">
        <rdf:type rdf:resource="#EnvironmentalFactor"/>
        <rdfs:label>Warm Temperature (24-32°C)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Env_CoolWet">
        <rdf:type rdf:resource="#EnvironmentalFactor"/>
        <rdfs:label>Cool and Wet Weather (16-24°C)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Fruits -->
    <owl:NamedIndividual rdf:about="#Fruit_Mango">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Mango</rdfs:label>
        <scientificName>Mangifera indica</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Apple">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Apple</rdfs:label>
        <scientificName>Malus domestica</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Grape">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Grape</rdfs:label>
        <scientificName>Vitis vinifera</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Orange">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Orange</rdfs:label>
        <scientificName>Citrus sinensis</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Banana">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Banana</rdfs:label>
        <scientificName>Musa acuminata</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Guava">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Guava</rdfs:label>
        <scientificName>Psidium guajava</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Papaya">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Papaya</rdfs:label>
        <scientificName>Carica papaya</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Tomato">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Tomato</rdfs:label>
        <scientificName>Solanum lycopersicum</scientificName>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Fruit_Pomegranate">
        <rdf:type rdf:resource="#Fruit"/>
        <rdfs:label>Pomegranate</rdfs:label>
        <scientificName>Punica granatum</scientificName>
    </owl:NamedIndividual>

    <!-- Pathogens -->
    <owl:NamedIndividual rdf:about="#Pathogen_ColletotrichumGloeosporioides">
        <rdf:type rdf:resource="#Pathogen"/>
        <rdfs:label>Colletotrichum gloeosporioides (Fungus)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Pathogen_VenturiaInaequalis">
        <rdf:type rdf:resource="#Pathogen"/>
        <rdfs:label>Venturia inaequalis (Fungus)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Pathogen_XanthomonasCitri">
        <rdf:type rdf:resource="#Pathogen"/>
        <rdfs:label>Xanthomonas citri (Bacterium)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Pathogen_GuignardiaBidwellii">
        <rdf:type rdf:resource="#Pathogen"/>
        <rdfs:label>Guignardia bidwellii (Fungus)</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Pathogen_PseudocercosporaFijiensis">
        <rdf:type rdf:resource="#Pathogen"/>
        <rdfs:label>Pseudocercospora fijiensis (Fungus)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Symptoms -->
    <owl:NamedIndividual rdf:about="#Symptom_BlackSpot">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Black Spot</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_Lesion">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Lesion</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_OliveGreenSpot">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Olive Green Spot</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_PowderySurface">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Powdery Surface</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_FruitRot">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Fruit Rot</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_YellowLeaves">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Yellow Leaves</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Symptom_CankerLesions">
        <rdf:type rdf:resource="#Symptom"/>
        <rdfs:label>Raised Corky Lesions with Yellow Halo</rdfs:label>
    </owl:NamedIndividual>

    <!-- Treatments -->
    <owl:NamedIndividual rdf:about="#Treatment_PruningSanitation">
        <rdf:type rdf:resource="#Treatment"/>
        <rdfs:label>Pruning and Sanitation</rdfs:label>
        <description>Prune dead or infected twigs and destroy leaf litter to prevent pathogen overwintering.</description>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Treatment_CopperFungicide">
        <rdf:type rdf:resource="#Treatment"/>
        <rdfs:label>Copper-based Protectant Spray</rdfs:label>
        <description>Apply preventive copper oxychloride at recommended agricultural dilution before heavy rains.</description>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Treatment_NeemOilBioControl">
        <rdf:type rdf:resource="#Treatment"/>
        <rdfs:label>Neem Oil &amp; Bio-agent Formulation</rdfs:label>
        <description>Apply 0.5% cold-pressed neem seed oil emulsion or Bacillus subtilis biological suspension.</description>
    </owl:NamedIndividual>

    <!-- Preventions -->
    <owl:NamedIndividual rdf:about="#Prevention_ProperCanopyAirflow">
        <rdf:type rdf:resource="#Prevention"/>
        <rdfs:label>Canopy Management &amp; Airflow</rdfs:label>
        <description>Ensure adequate spacing and open center pruning for maximum sunlight penetration and leaf drying.</description>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Prevention_DripIrrigation">
        <rdf:type rdf:resource="#Prevention"/>
        <rdfs:label>Drip Irrigation vs Overhead Watering</rdfs:label>
        <description>Prevent leaf wetness duration by applying water directly at the root zone via drip lines.</description>
    </owl:NamedIndividual>

    <!-- Diseases -->
    <owl:NamedIndividual rdf:about="#Disease_MangoAnthracnose">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Mango Anthracnose</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Mango"/>
        <causedBy rdf:resource="#Pathogen_ColletotrichumGloeosporioides"/>
        <causesSymptom rdf:resource="#Symptom_BlackSpot"/>
        <causesSymptom rdf:resource="#Symptom_Lesion"/>
        <causesSymptom rdf:resource="#Symptom_FruitRot"/>
        <favoredBy rdf:resource="#Env_HighHumidity"/>
        <favoredBy rdf:resource="#Env_WarmTemperature"/>
        <hasSeverity rdf:resource="#Severity_High"/>
        <treatedBy rdf:resource="#Treatment_PruningSanitation"/>
        <treatedBy rdf:resource="#Treatment_CopperFungicide"/>
        <preventedBy rdf:resource="#Prevention_ProperCanopyAirflow"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_AppleScab">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Apple Scab</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Apple"/>
        <causedBy rdf:resource="#Pathogen_VenturiaInaequalis"/>
        <causesSymptom rdf:resource="#Symptom_OliveGreenSpot"/>
        <causesSymptom rdf:resource="#Symptom_Lesion"/>
        <favoredBy rdf:resource="#Env_CoolWet"/>
        <hasSeverity rdf:resource="#Severity_Moderate"/>
        <treatedBy rdf:resource="#Treatment_PruningSanitation"/>
        <preventedBy rdf:resource="#Prevention_ProperCanopyAirflow"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_CitrusCanker">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Citrus Canker</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Orange"/>
        <causedBy rdf:resource="#Pathogen_XanthomonasCitri"/>
        <causesSymptom rdf:resource="#Symptom_CankerLesions"/>
        <causesSymptom rdf:resource="#Symptom_YellowLeaves"/>
        <favoredBy rdf:resource="#Env_HighHumidity"/>
        <hasSeverity rdf:resource="#Severity_High"/>
        <treatedBy rdf:resource="#Treatment_CopperFungicide"/>
        <preventedBy rdf:resource="#Prevention_DripIrrigation"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_GrapeBlackRot">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Grape Black Rot</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Grape"/>
        <causedBy rdf:resource="#Pathogen_GuignardiaBidwellii"/>
        <causesSymptom rdf:resource="#Symptom_BlackSpot"/>
        <causesSymptom rdf:resource="#Symptom_FruitRot"/>
        <favoredBy rdf:resource="#Env_WarmTemperature"/>
        <hasSeverity rdf:resource="#Severity_High"/>
        <treatedBy rdf:resource="#Treatment_PruningSanitation"/>
        <preventedBy rdf:resource="#Prevention_ProperCanopyAirflow"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_BananaSigatoka">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Banana Sigatoka</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Banana"/>
        <causedBy rdf:resource="#Pathogen_PseudocercosporaFijiensis"/>
        <causesSymptom rdf:resource="#Symptom_YellowLeaves"/>
        <causesSymptom rdf:resource="#Symptom_Lesion"/>
        <favoredBy rdf:resource="#Env_HighHumidity"/>
        <hasSeverity rdf:resource="#Severity_High"/>
        <treatedBy rdf:resource="#Treatment_PruningSanitation"/>
        <preventedBy rdf:resource="#Prevention_DripIrrigation"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_MangoHealthy">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Mango Healthy</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Mango"/>
        <hasSeverity rdf:resource="#Severity_Healthy"/>
        <preventedBy rdf:resource="#Prevention_ProperCanopyAirflow"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Disease_AppleHealthy">
        <rdf:type rdf:resource="#Disease"/>
        <rdfs:label>Apple Healthy</rdfs:label>
        <affectsFruit rdf:resource="#Fruit_Apple"/>
        <hasSeverity rdf:resource="#Severity_Healthy"/>
        <preventedBy rdf:resource="#Prevention_ProperCanopyAirflow"/>
    </owl:NamedIndividual>

</rdf:RDF>
